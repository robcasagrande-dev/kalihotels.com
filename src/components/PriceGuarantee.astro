---
import { getTranslations } from '../utils/i18n.js';

const { lang } = Astro.props;
const t = getTranslations(lang);
---
<div class="price-guarantee-container reveal-on-scroll">
  <div class="price-guarantee-card glass">
    <div class="guarantee-header">
      <span class="guarantee-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-top:-1px;">
          <path d="M5.338 1.59a.5.5 0 0 1 .278-.253l5-2a.5.5 0 0 1 .57.104l.03.03.01.011a.5.5 0 0 1 .054.43l-.75 3a.5.5 0 0 1-.416.368l-5 .5a.5.5 0 0 1-.497-.376l-.75-3.5z"/>
          <path fill-rule="evenodd" d="M8 14.933a.8.8 0 0 0 .1-.025l4.847-1.455c.348-.104.606-.409.606-.77V4.079a.3.3 0 0 0-.277-.3l-5.5 1.1a.3.3 0 0 0-.223.29v9.764zM7.059.435a2 2 0 0 1 1.882 0l6 3A2 2 0 0 1 16 5.2v6.233a3 3 0 0 1-1.817 2.756l-5.5 2.5a2 2 0 0 1-1.683 0l-5.5-2.5A3 3 0 0 1 0 11.433V5.2a2 2 0 0 1 1.059-1.765l6-3zM8 5.593l-.854.853a.5.5 0 0 0 .708.708L8 6.299l1.146 1.147a.5.5 0 0 0 .708-.708L9 5.593l.854-.853a.5.5 0 0 0-.708-.708L8 4.885 6.854 3.738a.5.5 0 0 0-.708.708L7 5.593z"/>
        </svg>
        {t.guarantee.title}
      </span>
      <h3 class="guarantee-title">{t.guarantee.subtitle}</h3>
    </div>
    
    <div id="guarantee-form-block">
      <form id="guarantee-email-form" class="guarantee-form" data-err-server={t.guarantee.error_server} data-err-connection={t.guarantee.error_connection}>
        <input 
          type="email" 
          id="guarantee-email-input" 
          name="email" 
          placeholder={t.guarantee.placeholder} 
          class="input-field email-field" 
          required 
        />
        <button type="submit" id="guarantee-submit-btn" class="btn-gold guarantee-btn">
          <span class="btn-text">{t.guarantee.button}</span>
          <span class="spinner hidden"></span>
        </button>
      </form>
      <div id="guarantee-error-message" class="error-msg hidden"></div>
    </div>

    <div id="guarantee-success-block" class="success-block hidden">
      <div class="success-icon-wrapper">
        <div class="success-checkmark"></div>
      </div>
      <p id="guarantee-success-text" class="success-text">{t.guarantee.success}</p>
      
      <div class="code-container">
        <span class="code-label">{t.guarantee.code_label}</span>
        <strong id="promo-code-val">SDBOOK</strong>
        <button id="copy-code-btn" class="btn-copy" aria-label={t.guarantee.copy_aria}>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
            <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
          </svg>
        </button>
      </div>

      <div class="email-cta-row">
        <span class="email-cta-label">{t.guarantee.email_cta}</span>
        <a
          href="mailto:reservas.kalihotels@gmail.com?subject=Mejor%20precio%20encontrado%20%E2%80%94%20SDBOOK&body=Hola%2C%20encontr%C3%A9%20un%20precio%20m%C3%A1s%20bajo%20en%20[OTA].%20Adjunto%20captura%20de%20pantalla."
          class="email-cta-link"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" style="margin-top:-1px;">
            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
          </svg>
          reservas.kalihotels@gmail.com
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('guarantee-email-form') as HTMLFormElement;
  const input = document.getElementById('guarantee-email-input') as HTMLInputElement;
  const btn = document.getElementById('guarantee-submit-btn') as HTMLButtonElement;
  const btnText = btn?.querySelector('.btn-text');
  const spinner = btn?.querySelector('.spinner');
  
  const formBlock = document.getElementById('guarantee-form-block');
  const successBlock = document.getElementById('guarantee-success-block');
  const errorMsg = document.getElementById('guarantee-error-message');
  
  const copyBtn = document.getElementById('copy-code-btn');
  const codeVal = document.getElementById('promo-code-val');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = input.value.trim();
      if (!email) return;

      // Reset state
      errorMsg?.classList.add('hidden');
      if (spinner && btnText) {
        spinner.classList.remove('hidden');
        btnText.textContent = '';
        btn.disabled = true;
      }

      try {
        const response = await fetch('https://api.kalihotels.com/save-lead', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ email })
        });

        if (!response.ok) {
          const errServer = form.dataset.errServer || 'Server error. Please try again.';
          throw new Error(errServer);
        }

        const data = await response.json();
        
        if (data.status === 'success') {
          formBlock?.classList.add('hidden');
          successBlock?.classList.remove('hidden');
        } else {
          throw new Error(data.error || 'Response error');
        }
      } catch (err: any) {
        console.error('Submit error:', err);
        if (errorMsg) {
          const errConnection = form.dataset.errConnection || 'Connection error. Please try again.';
          errorMsg.textContent = err.message || errConnection;
          errorMsg.classList.remove('hidden');
        }
        
        // Reset button
        if (spinner && btnText) {
          spinner.classList.add('hidden');
          btnText.textContent = btn.getAttribute('data-original-text') || 'Unlock Best Price';
          btn.disabled = false;
        }
      }
    });
    
    // Store original text
    if (btn && btnText) {
      btn.setAttribute('data-original-text', btnText.textContent || '');
    }
  }

  // Copy code click handler
  if (copyBtn && codeVal) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(codeVal.textContent || 'SDBOOK').then(() => {
        copyBtn.classList.add('copied');
        setTimeout(() => copyBtn.classList.remove('copied'), 2000);
      });
    });
  }
</script>

<style>
  .price-guarantee-container {
    width: 100%;
    max-width: 1100px;
    margin: 2.5rem auto 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 10;
  }

  .price-guarantee-card {
    padding: 2.5rem;
    border-radius: 12px;
    text-align: center;
    border: 1px dashed rgba(197, 168, 92, 0.35);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
  }

  .guarantee-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.8rem;
  }

  .guarantee-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    background: rgba(197, 168, 92, 0.08);
    padding: 0.4rem 1.2rem;
    border-radius: 20px;
    border: 1px solid rgba(197, 168, 92, 0.25);
  }

  .guarantee-title {
    font-size: 1.3rem;
    color: var(--text-main);
    font-family: var(--font-heading);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .guarantee-form {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    gap: 1rem;
  }

  .email-field {
    flex: 1;
    background: rgba(255, 255, 255, 0.03);
    height: 48px;
    border-radius: 6px;
  }

  .guarantee-btn {
    flex-shrink: 0;
    height: 48px;
    padding: 0 2rem;
    min-width: 190px;
    border-radius: 6px;
  }

  .error-msg {
    color: #ff5252;
    font-size: 0.85rem;
    margin-top: 1rem;
    text-align: center;
  }

  .success-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    max-width: 750px;
    margin: 0 auto;
    animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .success-icon-wrapper {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(76, 175, 80, 0.1);
    border: 1px solid rgba(76, 175, 80, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-checkmark {
    width: 10px;
    height: 18px;
    border: solid #4CAF50;
    border-width: 0 3px 3px 0;
    transform: rotate(45deg);
    margin-bottom: 4px;
  }

  .success-text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .code-container {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    margin-top: 0.5rem;
  }

  .code-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  #promo-code-val {
    font-size: 1.15rem;
    color: var(--color-gold);
    letter-spacing: 0.05em;
  }

  .btn-copy {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
    outline: none;
    padding: 0;
  }

  .btn-copy:hover {
    color: var(--color-gold);
  }

  .btn-copy.copied {
    color: #4CAF50;
    transform: scale(1.1);
  }

  .email-cta-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    font-size: 0.82rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .email-cta-label {
    color: var(--text-muted);
  }

  .email-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-gold);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-fast);
    border-bottom: 1px solid transparent;
  }

  .email-cta-link:hover {
    border-bottom-color: var(--color-gold);
    opacity: 0.85;
  }

  /* Loading Spinner */
  .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: #fff;
    animation: spin 0.8s linear infinite;
    display: inline-block;
  }

  .hidden {
    display: none !important;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .guarantee-form {
      flex-direction: column;
      align-items: stretch;
    }
    .guarantee-btn {
      width: 100%;
    }
  }
</style>
