---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, LANGUAGES } from '../../utils/i18n.js';

export function getStaticPaths() {
  return LANGUAGES.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getTranslations(lang);

const baseUrl = `https://kalihotels.com/${lang}/location/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": t.location.title,
    "description": t.location.subtitle,
    "step": [
      {
        "@type": "HowToStep",
        "name": t.location.airport,
        "text": t.location.airport_desc
      },
      {
        "@type": "HowToStep",
        "name": t.location.tayrona,
        "text": t.location.tayrona_desc
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": t.faq.home.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Kali Hotels", "item": `https://kalihotels.com/${lang}/` },
      { "@type": "ListItem", "position": 2, "name": "Location", "item": baseUrl }
    ]
  }
];
---

<BaseLayout 
  title={`${t.location.title} | Kali Hotels`} 
  description={t.location.subtitle} 
  lang={lang} 
  schema={schema}
>
  <section class="location-hero">
    <div class="hero-overlay"></div>
    <div class="hero-text container text-center">
      <h1 class="property-title">{t.location.title}</h1>
      <p class="property-subtitle">{t.location.subtitle}</p>
    </div>
  </section>

  <section class="container" style="padding: 6rem 2rem;">
    <div class="glass" style="padding: 4rem; border-radius: 12px; max-width: 900px; margin: 0 auto;">
      <h2 style="color: var(--color-gold); margin-bottom: 1.5rem; font-size: 2rem;">{t.location.airport}</h2>
      <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8; margin-bottom: 3rem;">{t.location.airport_desc}</p>
      
      <h2 style="color: var(--color-gold); margin-bottom: 1.5rem; font-size: 2rem;">{t.location.tayrona}</h2>
      <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8;">{t.location.tayrona_desc}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .location-hero {
    position: relative;
    height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: url('/images/uploads/2023/05/casa-de-leda-18-1024x585.jpg');
    background-size: cover;
    background-position: center;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(11, 12, 16, 0.6) 0%, rgba(11, 12, 16, 0.9) 100%);
    z-index: 1;
  }
  
  .hero-text {
    position: relative;
    z-index: 2;
    padding-top: 80px;
    text-align: center;
  }
  
  .property-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--text-main);
    margin-bottom: 1rem;
  }
  
  .property-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text-muted);
  }
</style>
