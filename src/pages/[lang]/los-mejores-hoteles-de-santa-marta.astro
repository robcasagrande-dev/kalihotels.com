---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import PriceGuarantee from '../../components/PriceGuarantee.astro';
import { getTranslations, LANGUAGES } from '../../utils/i18n.js';

export function getStaticPaths() {
  return LANGUAGES.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getTranslations(lang);

const baseUrl = `https://kalihotels.com/${lang}/los-mejores-hoteles-de-santa-marta/`;

// Construct ItemList Schema for "Best Hotels in Santa Marta"
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": t.seo.best_hotels.title,
    "description": t.seo.best_hotels.description,
    "url": baseUrl,
    "numberOfItems": 3,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Hotel",
          "name": "Casa de Leda, a Kali Hotel",
          "description": "Best luxury boutique hotel with subterranean Roman spa and rooftop pool in Santa Marta Historic Center.",
          "url": `https://kalihotels.com/${lang}/casa-leda/`,
          "image": "https://kalihotels.com/images/casa-de-leda-03-1024x585.jpg",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Calle 15 # 4-65",
            "addressLocality": "Santa Marta",
            "addressRegion": "Magdalena",
            "addressCountry": "CO"
          },
          "starRating": { "@type": "Rating", "ratingValue": "5" }
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Hotel",
          "name": "Casa de Isabella, a Kali Hotel",
          "description": "Best luxury colonial boutique hotel with private plunge pools in Santa Marta Historic Center.",
          "url": `https://kalihotels.com/${lang}/casa-isabella/`,
          "image": "https://kalihotels.com/images/casa-isabella-01-33-683x1024.jpg",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Calle 21 # 3-34",
            "addressLocality": "Santa Marta",
            "addressRegion": "Magdalena",
            "addressCountry": "CO"
          },
          "starRating": { "@type": "Rating", "ratingValue": "5" }
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "Hotel",
          "name": "Villa María Tayrona, a Kali Hotel",
          "description": "Best luxury eco-resort with ocean & jungle view bungalows next to Tayrona National Park entrance.",
          "url": `https://kalihotels.com/${lang}/villa-maria/`,
          "image": "https://kalihotels.com/images/VILLA-MARIA-DRONE-18-1.jpg",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Km 35 Vía Riohacha",
            "addressLocality": "Santa Marta",
            "addressRegion": "Magdalena",
            "addressCountry": "CO"
          },
          "starRating": { "@type": "Rating", "ratingValue": "5" }
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": t.faq.home.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Kali Hotels", "item": `https://kalihotels.com/${lang}/` },
      { "@type": "ListItem", "position": 2, "name": t.seo.best_hotels.title, "item": baseUrl }
    ]
  }
];

const content = {
  es: {
    hero_tag: "GUÍA DE LUJO 2026",
    hero_title: "Los 3 Mejores Hoteles en Santa Marta y Tayrona",
    hero_sub: "Comparativa exclusiva de los mejores hoteles boutique de lujo en el Centro Histórico y bungalows privados frente al mar Caribe.",
    leda_badge: "#1 Spa Subterráneo Romano & Rooftop Pool",
    isabella_badge: "#1 Hotel Colonial con Piscina Privada",
    maria_badge: "#1 Bungalows de Eco-Lujo frente al Mar",
    view_details: "Explorar Santuario",
    book_direct: "Reservar con 10% Descuento",
    why_book: "¿Por qué alojarse en un Santuario Kali Hotels?",
    why_p1: "Ya sea que busques el encanto colonial y la alta gastronomía del Centro Histórico de Santa Marta o la serenidad de la selva tropical del Parque Tayrona, Kali Hotels ofrece los tres santuarios boutique mejor valorados de Colombia.",
    why_p2: "Disfruta de beneficios exclusivos al reservar directo: 10% de descuento garantizado con el código SDBOOK, cóctel de bienvenida artesanal y upgrade de habitación sujeto a disponibilidad."
  },
  en: {
    hero_tag: "LUXURY GUIDE 2026",
    hero_title: "Top 3 Best Luxury Hotels in Santa Marta & Tayrona",
    hero_sub: "An exclusive comparison of top luxury boutique hotels in the Historic Center and private ocean-view bungalows near Tayrona National Park.",
    leda_badge: "#1 Subterranean Roman Spa & Rooftop Pool",
    isabella_badge: "#1 Colonial Boutique Hotel with Private Pools",
    maria_badge: "#1 Luxury Ocean & Jungle Eco-Bungalows",
    view_details: "Explore Sanctuary",
    book_direct: "Book Direct with 10% Off",
    why_book: "Why Stay at a Kali Hotels Sanctuary?",
    why_p1: "Whether you seek the colonial heritage and dining scene of Santa Marta's Historic Center or the untouched rainforest of Tayrona National Park, Kali Hotels features the region's top three luxury sanctuaries.",
    why_p2: "Enjoy exclusive perks when booking direct: guaranteed 10% discount using code SDBOOK, complimentary welcome cocktail, and priority room upgrades."
  },
  de: {
    hero_tag: "LUXUS GUIDE 2026",
    hero_title: "Die 3 besten Luxushotels in Santa Marta & Tayrona",
    hero_sub: "Ein exklusiver Vergleich der besten Boutique-Hotels in der Altstadt und privaten Dschungel-Bungalows am Tayrona Park.",
    leda_badge: "#1 Römisches Spa & Rooftop-Pool",
    isabella_badge: "#1 Koloniales Luxus-Hotel mit privatem Pool",
    maria_badge: "#1 Luxus-Bungalows am Tayrona Park",
    view_details: "Details Ansehen",
    book_direct: "Direkt buchen (10% Rabatt)",
    why_book: "Warum bei Kali Hotels buchen?",
    why_p1: "Egal ob Sie kolonialen Charme in der Altstadt von Santa Marta oder Natur am Tayrona-Nationalpark suchen, Kali Hotels bietet die drei am besten bewerteten Refugien der Region.",
    why_p2: "Genießen Sie exklusive Vorteile bei Direktbuchung: 10% Rabatt mit Code SDBOOK, Begrüßungscocktail und bevorzugtes Zimmer-Upgrade."
  },
  fr: {
    hero_tag: "GUIDE DE LUXE 2026",
    hero_title: "Les 3 Meilleurs Hôtels de Luxe à Santa Marta & Tayrona",
    hero_sub: "Un comparatif exclusif des meilleurs hôtels boutique du Centre Historique et bungalows éco-luxe avec vue mer au Parc Tayrona.",
    leda_badge: "#1 Spa Romain Souterrain & Rooftop Pool",
    isabella_badge: "#1 Hôtel Colonial avec Bassin Privé",
    maria_badge: "#1 Bungalows Éco-Luxe au Parc Tayrona",
    view_details: "Explorer le Sanctuaires",
    book_direct: "Réserver Direct (-10%)",
    why_book: "Pourquoi Choisir un Sanctuaire Kali Hotels?",
    why_p1: "Que vous recherchiez le charme colonial de Santa Marta ou la sérénité du Parc National Tayrona, Kali Hotels propose les trois sanctuaires boutiques les mieux notés de la région.",
    why_p2: "Profitez d'avantages exclusifs en réservant en direct: 10% de réduction garantie avec le code SDBOOK, cocktail de bienvenue offert et surclassement prioritaire."
  },
  it: {
    hero_tag: "GUIDA DI LUSSO 2026",
    hero_title: "I 3 Migliori Hotel di Lusso a Santa Marta e Tayrona",
    hero_sub: "Confronto esclusivo dei migliori boutique hotel nel Centro Storico e bungalow privati con vista mare al Parco Tayrona.",
    leda_badge: "#1 Spa Romana Sotterranea & Rooftop Pool",
    isabella_badge: "#1 Boutique Hotel Coloniale con Piscina Privata",
    maria_badge: "#1 Bungalow di Lusso al Parco Tayrona",
    view_details: "Esplora Santuario",
    book_direct: "Prenota Diretto (10% Sconto)",
    why_book: "Perché soggiornare nei Santuari Kali Hotels?",
    why_p1: "Che tu cerchi il fascino coloniale del Centro Storico di Santa Marta o la natura incontaminata del Parco Nazionale Tayrona, Kali Hotels offre i tre santuari boutique più votati della regione.",
    why_p2: "Goditi vantaggi esclusivi prenotando direttamente: 10% di sconto garantito con codice SDBOOK, cocktail di benvenuto e upgrade di camera."
  }
}[lang as 'es' | 'en' | 'de' | 'fr' | 'it'] || content['es'];
---

<BaseLayout 
  title={t.seo.best_hotels.title} 
  description={t.seo.best_hotels.description} 
  lang={lang} 
  schema={schema}
>
  <!-- Luxury Hero Section with Background Backdrop -->
  <section class="guide-hero">
    <div class="hero-bg-overlay"></div>
    <div class="container hero-container text-center">
      <span class="guide-badge">{content.hero_tag}</span>
      <h1 class="guide-title">{content.hero_title}</h1>
      <p class="guide-subtitle">{content.hero_sub}</p>
    </div>
  </section>

  <!-- Live Booking Widget Container -->
  <section class="guide-booking-section container">
    <div class="booking-wrapper glass">
      <BookingWidget lang={lang} />
    </div>
  </section>

  <!-- Main Hotels Comparison Listicles Section -->
  <section class="hotels-list-section container">
    <!-- Hotel #1: Casa de Leda -->
    <article class="hotel-card glass reveal-on-scroll">
      <div class="hotel-card-image">
        <span class="hotel-rank-badge">#1</span>
        <img src="/images/casa-de-leda-03-1024x585.jpg" alt="Casa de Leda Roman Spa & Rooftop Pool" width="1024" height="585" loading="eager" fetchpriority="high" />
      </div>
      <div class="hotel-card-content">
        <div class="rating-stars">★★★★★ <span class="rating-label">5.0 LUXURY RATING</span></div>
        <span class="hotel-category">{content.leda_badge}</span>
        <h2 class="hotel-name">Casa de Leda, a Kali Hotel</h2>
        <p class="hotel-location">📍 Centro Histórico, Santa Marta</p>
        <p class="hotel-desc">{t.santuarios.leda_desc}</p>
        <ul class="hotel-features">
          <li><span class="check-icon">✓</span> Spa Romano Subterráneo Privado</li>
          <li><span class="check-icon">✓</span> Piscina en la Azotea con Bar & Vistas Panorama</li>
          <li><span class="check-icon">✓</span> A 2 min del Parque de los Novios</li>
        </ul>
        <div class="hotel-card-actions">
          <a href={`/${lang}/casa-leda/`} class="btn-secondary">{content.view_details}</a>
          <a href="https://wubook.net/nneb/mprop?f=today&n=1&ep=4e454d97&w_id=4791" target="_blank" rel="noopener noreferrer" class="btn-gold">{content.book_direct}</a>
        </div>
      </div>
    </article>

    <!-- Hotel #2: Casa de Isabella -->
    <article class="hotel-card glass reveal-on-scroll">
      <div class="hotel-card-image">
        <span class="hotel-rank-badge">#2</span>
        <img src="/images/casa-isabella-01-33-683x1024.jpg" alt="Casa de Isabella Private Pool" width="683" height="1024" loading="lazy" />
      </div>
      <div class="hotel-card-content">
        <div class="rating-stars">★★★★★ <span class="rating-label">5.0 LUXURY RATING</span></div>
        <span class="hotel-category">{content.isabella_badge}</span>
        <h2 class="hotel-name">Casa de Isabella, a Kali Hotel</h2>
        <p class="hotel-location">📍 Centro Histórico, Santa Marta</p>
        <p class="hotel-desc">{t.santuarios.isabella_desc}</p>
        <ul class="hotel-features">
          <li><span class="check-icon">✓</span> Patio Colonial con Piscina de Inmersión</li>
          <li><span class="check-icon">✓</span> Suites de Lujo con Piscina Privada</li>
          <li><span class="check-icon">✓</span> Desayunos Gourmet Inclusivos</li>
        </ul>
        <div class="hotel-card-actions">
          <a href={`/${lang}/casa-isabella/`} class="btn-secondary">{content.view_details}</a>
          <a href="https://wubook.net/nneb/mprop?f=today&n=1&ep=4e454d97&w_id=4791" target="_blank" rel="noopener noreferrer" class="btn-gold">{content.book_direct}</a>
        </div>
      </div>
    </article>

    <!-- Hotel #3: Villa María Tayrona -->
    <article class="hotel-card glass reveal-on-scroll">
      <div class="hotel-card-image">
        <span class="hotel-rank-badge">#3</span>
        <img src="/images/VILLA-MARIA-DRONE-18-1.jpg" alt="Villa Maria Tayrona Ocean View Bungalows" width="600" height="800" loading="lazy" />
      </div>
      <div class="hotel-card-content">
        <div class="rating-stars">★★★★★ <span class="rating-label">5.0 LUXURY RATING</span></div>
        <span class="hotel-category">{content.maria_badge}</span>
        <h2 class="hotel-name">Villa María Tayrona, a Kali Hotel</h2>
        <p class="hotel-location">📍 Parque Nacional Natural Tayrona (Km 35)</p>
        <p class="hotel-desc">{t.santuarios.maria_desc}</p>
        <ul class="hotel-features">
          <li><span class="check-icon">✓</span> Bungalows de Lujo con Vistas al Mar y Selva</li>
          <li><span class="check-icon">✓</span> Piscina Infinita sobre la Sierra Nevada</li>
          <li><span class="check-icon">✓</span> A 3 km de la Entrada Principal El Zaino</li>
        </ul>
        <div class="hotel-card-actions">
          <a href={`/${lang}/villa-maria/`} class="btn-secondary">{content.view_details}</a>
          <a href="https://wubook.net/nneb/mprop?f=today&n=1&ep=4e454d97&w_id=4791" target="_blank" rel="noopener noreferrer" class="btn-gold">{content.book_direct}</a>
        </div>
      </div>
    </article>
  </section>

  <!-- Price Guarantee Discount Section -->
  <section class="guarantee-section container">
    <PriceGuarantee lang={lang} />
  </section>

  <!-- Authoritative Content Block -->
  <section class="guide-content-section container">
    <div class="guide-content-card glass reveal-on-scroll">
      <h2>{content.why_book}</h2>
      <p>{content.why_p1}</p>
      <p>{content.why_p2}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .guide-hero {
    position: relative;
    padding: 9rem 1.5rem 5rem;
    margin-top: 80px;
    background-image: url('/images/VILLA-MARIA-DRONE-18-1.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-bottom: 1px solid var(--glass-border);
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 8, 10, 0.75) 0%, rgba(11, 12, 16, 0.95) 100%);
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }

  .guide-badge {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: rgba(212, 175, 55, 0.2);
    border: 1px solid #d4af37;
    color: #f3e5ab;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    border-radius: 30px;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }

  .guide-title {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  }

  .guide-subtitle {
    font-size: 1.2rem;
    line-height: 1.7;
    color: #e2e8f0;
    max-width: 820px;
    margin: 0 auto;
    font-weight: 400;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .guide-booking-section {
    margin-top: -2rem;
    margin-bottom: 3rem;
    position: relative;
    z-index: 10;
  }

  .booking-wrapper {
    padding: 1rem;
    border-radius: 16px;
    background: rgba(15, 18, 25, 0.85);
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .hotels-list-section {
    padding: 2rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .hotel-card {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2.5rem;
    border-radius: 20px;
    overflow: hidden;
    background: rgba(20, 24, 33, 0.75);
    border: 1px solid var(--glass-border);
    transition: var(--transition-smooth);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .hotel-card:hover {
    transform: translateY(-6px);
    border-color: #d4af37;
    box-shadow: 0 15px 40px rgba(212, 175, 55, 0.15);
  }

  .hotel-card-image {
    position: relative;
    height: 100%;
    min-height: 360px;
  }

  .hotel-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hotel-rank-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, #d4af37 0%, #aa820a 100%);
    color: #000;
    font-size: 1.5rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    border: 2px solid #fff;
  }

  .hotel-card-content {
    padding: 2.5rem 2.5rem 2.5rem 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .rating-stars {
    color: #d4af37;
    font-size: 1.1rem;
    letter-spacing: 0.15em;
    margin-bottom: 0.4rem;

  }

  .rating-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-left: 0.5rem;
  }

  .hotel-category {
    font-size: 0.8rem;
    font-weight: 700;
    color: #d4af37;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.6rem;
  }

  .hotel-name {
    font-size: 2rem;
    color: #ffffff;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .hotel-location {
    font-size: 0.95rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .hotel-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin-bottom: 1.5rem;
  }

  .hotel-features {
    list-style: none;
    padding: 0;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: #e2e8f0;
  }

  .check-icon {
    color: #d4af37;
    font-weight: 800;
    margin-right: 0.5rem;
  }

  .hotel-card-actions {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .btn-gold {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #000000;
    background: linear-gradient(135deg, #d4af37 0%, #f3e5ab 100%);
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    transition: var(--transition-fast);
  }

  .btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.5);
  }

  .guarantee-section {
    padding: 2rem 1.5rem 4rem;
  }

  .guide-content-section {
    padding: 0 1.5rem 6rem;
  }

  .guide-content-card {
    padding: 3.5rem;
    border-radius: 20px;
    background: rgba(20, 24, 33, 0.75);
    border: 1px solid var(--glass-border);
  }

  .guide-content-card h2 {
    font-size: 2rem;
    color: #d4af37;
    margin-bottom: 1.25rem;
  }

  .guide-content-card p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #cbd5e1;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 900px) {
    .hotel-card {
      grid-template-columns: 1fr;
    }
    .hotel-card-content {
      padding: 1.75rem 1.75rem 2.25rem;
    }
    .guide-hero {
      padding: 7rem 1.25rem 4rem;
    }
  }
</style>
